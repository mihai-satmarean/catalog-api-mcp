# GitHub Secrets for CI/CD
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Ngrok Configuration
NGROK_AUTHTOKEN=your_ngrok_auth_token_here
NGROK_DOMAIN=your-custom-domain.ngrok-free.dev

# VPN Configuration (for K3s cluster access)
VPN_SERVER=vpn-server:port
VPN_USERNAME=vpn_username
VPN_PASSWORD=vpn_password
VPN_TRUSTED_CERT=trusted_cert_hash

# K3s Cluster Configuration (base64 encoded kubeconfig with PRIVATE IP)
KUBECONFIG_K3S_DEV=base64_encoded_kubeconfig_here

# API Keys for External Services
MIDOCEAN_TEST_API_KEY=your_midocean_test_api_key_here
MIDOCEAN_PROD_API_KEY=your_midocean_prod_api_key_here
XD_CONNECTS_PRODUCT_DATA_URL=your_xd_connects_url_here

# CI Test Mode (set to "true" to enable manual testing banner)
NEXT_PUBLIC_CI_TEST_MODE=false
